# Dependencies
node_modules/
.pnp.*
.yarn/

# Build artifacts
dist/
build/
coverage/
.nyc_output/

# Test artifacts
test-results/
playwright-report/
*.tsbuildinfo

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Env
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Scratch
*.tmp
scratch/
bench/.cache/
.env.bench

# Python bytecode (bench/modal/ uses local Python for renderers)
__pycache__/
*.pyc

# Bench runtime artifacts — authoritative numbers live in
# docs/bench/baseline.json + docs/bench/sweeps/*.md; raw JSONL traces
# and Modal --local-out mirrors are ephemeral. The Modal Volume
# (/data/runs/) holds durable copies.
docs/bench/runs/
*.log

# Playwright auth state (per-test user sessions)
tests/e2e/.auth/
