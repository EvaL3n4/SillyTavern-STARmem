{
    "name": "starmem",
    "version": "2.0.0-dev",
    "description": "STARmem—deterministic memory for SillyTavern roleplay",
    "type": "module",
    "private": true,
    "scripts": {
        "typecheck": "tsc --noEmit",
        "lint": "eslint 'src/**/*.js' 'tests/**/*.js'",
        "lint:fix": "eslint 'src/**/*.js' 'tests/**/*.js' --fix",
        "test": "node --experimental-vm-modules node_modules/.bin/jest",
        "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
        "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
        "bench": "node bench/cli.js",
        "bench:smoke": "node bench/cli.js --conversations 1",
        "bench:sweep:tau": "node bench/sweeps/tau.js",
        "bench:sweep:graph": "node bench/sweeps/graph.js",
        "bench:sweep:consolidation": "node bench/sweeps/consolidation.js",
        "bench:sweep:bm25": "node bench/sweeps/bm25.js",
        "bench:baselines": "node bench/baselines.js"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/jest": "^30.0.0",
        "eslint": "^9.0.0",
        "globals": "^15.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^30.3.0",
        "typescript": "^5.4.0"
    }
}
